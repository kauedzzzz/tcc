# Copie para .env e rode:  npm run start:env   (Node 20.6+)
PORT=3000
NODE_ENV=development

# OBRIGATÓRIO em produção: openssl rand -hex 48
JWT_SECRET=

# Login Google real (Google Cloud Console > Credenciais > ID do cliente OAuth Web)
GOOGLE_CLIENT_ID=

# 1 = permite entrar só com e-mail (SEM verificar posse). Use apenas em demonstração/desenvolvimento.
ALLOW_DEMO_LOGIN=0

# Origens que podem chamar a API de outro domínio (app nativo). Use * apenas se souber o que faz.
ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost

# Pasta do data.json (aponte para um disco persistente na hospedagem)
DATA_DIR=./server

# 1 quando estiver atrás de proxy/CDN (Render, Railway, Nginx...) para o limite de requisições ver o IP real
TRUST_PROXY=0

# 1 = mantém as notas/contagens fictícias do seed (apenas para apresentação)
KEEP_DEMO_RATINGS=0

# 1 = em produção, cria também o usuário demo (cidadao@onehealth.org / 123456) e alertas de demonstração
SEED_DEMO_DATA=0

# E-mails que recebem automaticamente perfil 'admin' ao se cadastrarem (separados por vírgula)
ADMIN_EMAILS=

# Persistência: 'json' (padrão local sem dependências externas) ou 'postgres' (PostgreSQL + PostGIS)
DB_DRIVER=json
DATABASE_URL=

# Retenção máxima de backups comprimidos (.json.gz) em DATA_DIR/backups/
BACKUP_RETENTION_COUNT=7


